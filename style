/* ==========================================================================
   4. BREAKPOINT 1: TABLET SCREENS (min-width: 768px)
   ========================================================================== */
@media screen and (min-width: 768px) {
    /* Navigation Bar Changes */
    .hideOnMobile {
        display: flex;
    }

    .menu-button {
        display: none;
    }

    nav ul {
        justify-content: flex-end;
    }

    nav li:first-child {
        margin-right: auto;
    }

    /* Hero Section */
