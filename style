    display: flex;
    justify-content: space-between;
    align-items: center;
}

nav li {
    height: 60px;
}

nav a {
    height: 100%;
    padding: 0 1rem;
    display: flex;
    align-items: center;
    text-decoration: none;
    color: var(--primary-color);
    font-size: var(--text-lg);
    transition: background-color var(--transition-base), color var(--transition-base);
}

nav a:hover,
