        height: 75vh;
    }

    /* Marquee Sizing */
    .item {
        font-size: var(--text-lg);
        padding: 0.6rem 1.2rem;
    }

    /* About Section Grid/Flex Side-by-Side */
    .page-container {
        flex-direction: row;
        /*align-items: flex-start;*/
        gap: 3rem;

        /*change*/
        justify-content: space-between;
        align-items: center;
        gap: clamp(2rem, 4vw, 3.5rem); /*prevents awkward spacing*/

    }

    .text-content {
        /*flex: 1;*/

        /*change*/
        flex: 1 1 55%; /*takes up ~55% of flexible space*/
        min-width: 0; /*prevents overflow issues with long text*/
    }

    .image {
        /*width: 45%;*/
        max-width: 300px;

        /*change*/
        flex: 0 0 45%; /*stays at ~45% of space*/
    }
}


/* ==========================================================================
   5. BREAKPOINT 2: LAPTOP SCREENS (min-width: 1024px)
   ========================================================================== */
@media screen and (min-width: 1024px) {
    /* Navigation Spacing */
    nav a {
        padding: 0 2rem;
    }

    /* Hero Height */
    .full-width-video {
        height: 85vh;
    }

    /* About Section Spacing */
    .about-section {
        padding-top: var(--space-3xl);
        padding-bottom: var(--space-3xl);
    }

    .page-container {
        /*gap: 4rem;*/

        /*change*/
        gap: clamp(3.5rem, 6vw, 5rem); /*prevents awkward spacing*/
    }

    /*add*/
    .text-content {
        flex: 1 1 50%; /*takes up ~60% of flexible space*/
    }

    .image {
        /*width: 40%;*/

        /*change*/
        flex: 0 0 42%; /*stays at ~40% of space*/
        max-width: 400px;
    }
}


/* ==========================================================================
   6. BREAKPOINT 3: LARGE DESKTOP SCREENS (min-width: 1440px)
   ========================================================================== */
