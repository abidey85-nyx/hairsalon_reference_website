* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    /* === MERGED VARIABLES (from global.css + local style.css) === */
    /* Color variables (preserve local project palette) */
    --color-bg: #ffffff; /* mapped from --primary-color */
    --color-text: #000000; /* mapped from --secondary-color */
    --color-accent: #005c14;
    --color-muted: #7f0000;

    /* Provide aliases so existing rules using the original style variables continue to work */
    --primary-color: var(--color-bg);
    --secondary-color: var(--color-text);

    /* === FONTS === */
    --font-primary: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    --font-heading: 'Georgia', 'Times New Roman', serif;
    --font-mono: 'Consolas', 'Monaco', 'Courier New', monospace; /* For code examples */
    --font-family: 'Bahnschrift', sans-serif; /* local alias retained */

    /* === FONT SIZES (using a modular scale) === */
    --text-xs: 0.75rem;      /* 12px */
    --text-sm: 0.875rem;     /* 14px */
    --text-base: 1rem;       /* 16px */
    --text-lg: 1.125rem;     /* 18px */
    --text-xl: 1.25rem;      /* 20px */
    --text-2xl: 1.5rem;      /* 24px */
    --text-3xl: 2rem;        /* 32px */
    --text-4xl: 2.5rem;      /* 40px */

    /* === SPACING === */
    --space-xs: 0.25rem;     /* 4px */
    --space-sm: 0.5rem;      /* 8px */
    --space-md: 1rem;        /* 16px */
    --space-lg: 1.5rem;      /* 24px */
    --space-xl: 2rem;        /* 32px */
    --space-2xl: 3rem;       /* 48px */
    --space-3xl: 4rem;       /* 64px */

    /* === LAYOUT === */
    --max-width: 900px;
    --max-content-width: 1440px; /* local value preserved */
    --border-radius-sm: 4px;
    --border-radius-md: 8px;
    --border-radius-lg: 16px;

    /* === ANIMATIONS === */
    --transition-fast: 150ms ease;
    --transition-base: 300ms ease;
    --transition-slow: 500ms ease;

    /* === SHADOWS === */
    --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.1);
    --shadow-md: 0 4px 6px rgba(0, 0, 0, 0.15);
    --shadow-lg: 0 10px 25px rgba(0, 0, 0, 0.2);

    /* === LOCAL LAYOUT/FLUID SIZING (kept from original style.css) === */
    --z-index: 1000; /* for sidebar and logo above*/
    --fluid-title: clamp(2.5rem, 5vw + 1rem, 5.5rem); 
    --fluid-body: clamp(1rem, 0.5vw + 0.8rem, 1.25rem);
    --section-padding: clamp(4rem, 8vh, 10rem);
}

body {
    min-height: 100vh;
    background-color: var(--primary-color);
    color: var(--secondary-color);
    font-family: var(--font-family);
}

nav {
    background-color: var(--secondary-color);
    box-shadow: 3px 3px 5px rgba(0, 0, 0, 0.1);
    overflow: hidden;
}

nav ul {
    width: 100%;
    list-style: none;
    display: flex;
    justify-content: flex-end;
    align-items: center;
}

nav li {
    height: 50px; /*defines navbar height*/
}

nav a {
    height: 100%;
    padding: 0 30px;
    display: flex;
    align-items: center;
    text-decoration: none;
    color: var(--primary-color);
    font-size: 1.5em;
}

nav a:hover {
    background-color: var(--primary-color);
    color: var(--secondary-color);
    transition: 0.6s;
}

nav li:first-child {
    margin-right: auto;
}

.sidebar {
    position: fixed;
    top: 0;
    right: -20px;
    height: 100vh;
    width: 300px;
    z-index: var(--z-index);
    background-color: var(--secondary-color);
    box-shadow: -10px 0 10px rgba(0, 0, 0, 0.1);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    font-size: 1.3em;
    transform: translateX(100%);
    visibility: hidden;
    pointer-events: none;
}

.sidebar li {
    width: 100%;
    padding-top: 40px;
}

.sidebar a {
    width: 100%;
}

@media(max-width: 700px) {
    .hideOnMobile {
        display: none;
    }
}

@media(min-width: 700px) {
    .menu-button {
        display: none;
    }
}

@media(max-width: 450px) {
    .sidebar {
        width: 100%;
    }
}

.full-width-video {
  width: 100%;
  object-fit: cover;
  height: 90vh;
  background-color: rgb(0, 0, 0); /* to show pre-allocated space */
  object-position: center; 
}
/* override for desktop */
@media only screen and (min-width: 480px) {
  .full-width-video {
    height: 90vh;
  }
}
.width-display {
  font-size: 50%;
  position: absolute;
  right: 1em;
  display: block;
  top: 1em;
}

/* Accessibility: visible skip link */
.skip-link {
    position: absolute;
    left: 0.75rem;
    top: 0.5rem;
    background: var(--secondary-color);
    color: var(--primary-color);
    padding: 0.5rem 0.75rem;
    z-index: calc(var(--z-index) + 10);
    transform: translateY(-120%);
}
.skip-link:focus {
    transform: translateY(0);
}

/* Animations */
@keyframes slideInBounce {
    0% { transform: translateX(100%); }
    55% { transform: translateX(-16px); }
    72% { transform: translateX(8px); }
    86% { transform: translateX(-4px); }
    100% { transform: translateX(0); }
}

@keyframes rubberClose {
    0% { transform: translateX(0) scaleX(1); }
    20% { transform: translateX(-12px) scaleX(1.03); }
    100% { transform: translateX(100%) scaleX(1); }
}

.sidebar--open {
    visibility: visible;
    pointer-events: auto;
    animation: slideInBounce 1.5s cubic-bezier(.22,.9,.29,1) forwards;
}

.sidebar--closing {
    visibility: visible;
    pointer-events: none;
    animation: rubberClose 1s cubic-bezier(.25,.1,.25,1) forwards;
}

/* Make sure links inside sidebar are keyboard-focusable and visible */
.sidebar a:focus {
    outline: 3px solid #fff;
    outline-offset: 2px;
}

/* infinite moving banner */
#container {
    width: 100%;
    height: 3rem;
    font-family: Montserrat;
    position: relative;
    overflow: hidden;
    white-space: nowrap;
    background: var(--secondary-color);
    color: var(--primary-color);
}
#container .scroll,
#container .scroll-one {
    background: var(--secondary-color);
    display: flex;
    align-items: center;
    justify-content: space-around;
    width: fit-content;
    white-space: nowrap;
    animation: loop 30s linear infinite both;
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
}

#container .scroll#scroll-two {
    transform: translateX(100%);
    animation-delay: -15s;
}

#container .fade {
    z-index: 2;
}
.fade {
    width: 100%;
    position: absolute;
    background: linear-gradient(
        90deg,
        #000,
        transparent 30%,
        transparent 90%,
        #000
    );
    inset: 0;
    pointer-events: none;
}
@keyframes loop {
    0% {transform: translateX(100%);}
    100% {transform: translateX(-100%);}
}
.item {
    display: flex;
    align-items: center;
    gap: 0 0.2rem;
    color: var(--primary-color);
    font-size: 1.3rem;
    padding: 0.7rem 1rem;
    margin: 0rem 1rem;
    border-radius: 0.4rem;
    white-space: nowrap;
    box-shadow:
    0 0.1rem 0.2rem #00000033,
    0 0.1rem 0.5rem #0000004d,
    0 0.2rem 01.5rem #00000066,
}

/* Page main content picture and text animation (about section) */

.about-section {
    padding: var(--section-padding);
    max-width: var(--max-content-width);
    margin: 0 auto;
}

.main-heading {
    font-size: var(--fluid-title);
    text-align: center;
    margin-bottom: 3rem;
}

.page-container {
  display: flex; /* Aligns the children horizontally */
  align-items: center; /* Centers items vertically */
  gap: 10%; /* Adds space between the text and image */
}

.text-content {
  flex: 1; /* Takes up remaining available space */
}

.image {
    width: 70%;
    max-width: 400px;
    height: auto;
}

