    .full-width-video {
        height: 90vh;
    }

    .about-section {
        max-width: var(--max-content-width);
    }

    .service-card {
        /* LAPTOP/DESKTOP: Exactly 3 cards visible */
        flex: 0 0 calc((100% - (var(--space-md) * 2)) / 3);
    }

    .top-overlay h3 {
        font-size: var(--text-xl);
    }

    .bottom-overlay .price {
        font-size: var(--text-lg);
    }

    .prev-btn { left: -20px; }
    .next-btn { right: -20px; }
}

/* ==========================================================================
   SERVICES SECTION & CAROUSEL
   ========================================================================== */
.services-section {
    padding: var(--section-padding) 1rem;
    max-width: var(--max-content-width);
    margin: 0 auto;
}

.services-title {
    font-size: var(--text-3xl);
    text-align: center;
    margin-bottom: var(--space-xl);
}

.carousel-wrapper {
    position: relative;
    display: flex;
    align-items: center;
}

/* Horizontal Scroll Container */
.services-carousel {
    display: flex;
    gap: var(--space-md);
    overflow-x: auto;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    padding: var(--space-sm) 0;
    /* Hide scrollbars across browsers */
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none; /* IE/Edge */
}

.services-carousel::-webkit-scrollbar {
    display: none; /* Chrome/Safari */
}

/* Individual Card Styling */
.service-card {
    /* MOBILE DEFAULT: Exactly 2 cards visible */
    flex: 0 0 calc((100% - var(--space-md)) / 2);
    aspect-ratio: 3 / 4; /* Maintains uniform card dimensions */
    position: relative;
    border-radius: var(--border-radius-md);
    overflow: hidden;
    scroll-snap-align: start;
    box-shadow: var(--shadow-md);
    cursor: pointer;
    background-color: var(--secondary-color);
}

/* Base Image Zoom Effect */
.service-card .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
}

/* Hover: Image Zoom */
.service-card:hover .card-img {
    transform: scale(1.12);
}

/* Overlays (Name on top, Price on bottom) */
.card-overlay {
    position: absolute;
    left: 0;
    right: 0;
    padding: var(--space-md);
    z-index: 2;
    transition: transform var(--transition-base), opacity var(--transition-base);
    background: linear-gradient(180deg, rgba(0,0,0,0.75) 0%, rgba(0,0,0,0) 100%);
    color: #ffffff;
}

.top-overlay {
    top: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0) 100%);
}

.top-overlay h3 {
    font-size: var(--text-lg);
    font-weight: 600;
    text-shadow: 0 2px 4px rgba(0,0,0,0.5);
}

.bottom-overlay {
    bottom: 0;
    background: linear-gradient(0deg, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0) 100%);
}

.bottom-overlay .price {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--primary-color);
    background-color: var(--color-accent);
    padding: 0.25rem 0.6rem;
    border-radius: var(--border-radius-sm);
    display: inline-block;
}

/* Hover: Smooth Text Slide Out */
.service-card:hover .top-overlay {
    transform: translateY(-100%);
    opacity: 0;
}

.service-card:hover .bottom-overlay {
    transform: translateY(100%);
    opacity: 0;
}

/* Carousel Control Buttons (Arrows) */
.carousel-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    background-color: var(--secondary-color);
    color: var(--primary-color);
    border: none;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: var(--shadow-lg);
    transition: background-color var(--transition-fast), opacity var(--transition-fast);
    opacity: 0.85;
}

.carousel-btn:hover {
    opacity: 1;
    background-color: var(--color-accent);
}

.carousel-btn:disabled {
    opacity: 0.2;
    cursor: not-allowed;
}

.prev-btn { left: -12px; }
.next-btn { right: -12px; }